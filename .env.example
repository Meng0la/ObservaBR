# Copie para .env e preencha cada senha com um valor aleatório distinto.
# Exemplo de gerador local: openssl rand -hex 32
POSTGRES_PASSWORD=
READER_PASSWORD=
WRITER_PASSWORD=

# Porta publicada somente no loopback.
PORT=3000

# Ano único opcional no Scout geral. Vazio usa a política de backfill.
COLLECTION_YEAR=
# Lista explícita opcional, em ordem; prevalece sobre o ano único.
SCOUT_COLLECTION_YEARS=
